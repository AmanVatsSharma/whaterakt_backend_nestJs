NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@db:5432/app
TYPEORM_LOGGING=false
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=true
JWT_SECRET=change-me
MFA_SECRET_KEY=super-secure-production-key
REDIS_HOST=redis
REDIS_PORT=6379

# WhatsApp — align Graph version with WHATSAPP_GRAPH_VERSION (v20.0 default in app config)
WHATSAPP_GRAPH_BASE=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_ACCESS_TOKEN=your-meta-token
WHATSAPP_DEFAULT_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=replace-this
WHATSAPP_APP_SECRET=replace-this

# Optional legacy mock (non-graph.facebook.com only)
# WHATSAPP_API_URL=

SHOPIFY_CLIENT_ID=replace-this
SHOPIFY_CLIENT_SECRET=replace-this
SHOPIFY_WEBHOOK_SECRET=replace-this
SHOPIFY_OAUTH_STATE_SECRET=replace-this
SHOPIFY_SCOPES=read_orders,read_customers
SHOPIFY_API_VERSION=2024-10
BACKEND_PUBLIC_URL=https://api.yourdomain.com
CORS_ORIGINS=https://your-frontend.example

# METRICS_BEARER_TOKEN=long-random-token-for-scraping-endpoint
# SWAGGER_ENABLED=false
