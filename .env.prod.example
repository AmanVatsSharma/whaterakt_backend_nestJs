NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@db:5432/app
TYPEORM_LOGGING=false
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=true
JWT_SECRET=change-me
MFA_SECRET_KEY=super-secure-production-key
REDIS_HOST=redis
REDIS_PORT=6379
WHATSAPP_API_URL=https://graph.facebook.com/v19.0/<PHONE_NUMBER_ID>/messages
WHATSAPP_ACCESS_TOKEN=your-meta-token
WHATSAPP_VERIFY_TOKEN=replace-this
WHATSAPP_APP_SECRET=replace-this
SHOPIFY_CLIENT_ID=replace-this
SHOPIFY_CLIENT_SECRET=replace-this
SHOPIFY_WEBHOOK_SECRET=replace-this
SHOPIFY_OAUTH_STATE_SECRET=replace-this
SHOPIFY_SCOPES=read_orders,read_customers
SHOPIFY_API_VERSION=2024-10
BACKEND_PUBLIC_URL=https://api.yourdomain.com
CORS_ORIGINS=https://your-frontend.example
