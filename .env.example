# Minimal dev defaults for local build/start
NODE_ENV=development
PORT=3000

# Database (PostgreSQL for local development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
TYPEORM_LOGGING=true
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=false

# Redis (optional in dev; BullModule handles undefined)
REDIS_HOST=localhost
REDIS_PORT=6379

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=development
WHATSAPP_GRAPH_BASE=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v20.0
# Map incoming phone_number_id -> tenantId for webhooks
WHATSAPP_TENANT_PHONE_MAP={"111":"tenant-1"}
# Optional default for outbound if mapping not found
WHATSAPP_DEFAULT_PHONE_NUMBER_ID=111
# Webhook security
WHATSAPP_VERIFY_TOKEN=verify-token
WHATSAPP_APP_SECRET=app-secret

# Shopify
SHOPIFY_CLIENT_ID=shopify-client-id
SHOPIFY_CLIENT_SECRET=shopify-client-secret
SHOPIFY_WEBHOOK_SECRET=shopify-webhook-secret
SHOPIFY_OAUTH_STATE_SECRET=shopify-oauth-state-secret
SHOPIFY_SCOPES=read_orders,read_customers
SHOPIFY_API_VERSION=2024-10
BACKEND_PUBLIC_URL=http://localhost:3000
# Optional explicit callback if backend is behind a reverse proxy
# SHOPIFY_OAUTH_REDIRECT_URI=https://api.yourdomain.com/shopify/oauth/callback

# JWT
JWT_SECRET=development-secret
MFA_SECRET_KEY=dev-mfa-secret-change-me

# AI (optional)
DEEPSEEK_API_URL=http://localhost:5000/mock
DEEPSEEK_API_KEY=dev-key

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limits
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Queue limiter
MESSAGES_QUEUE_LIMIT_MAX=1200
MESSAGES_QUEUE_LIMIT_DURATION=60000
