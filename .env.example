# Minimal dev defaults for local build/start
NODE_ENV=development
PORT=3000
# SQLite for dev (Prisma):
DATABASE_URL=file:./dev.db
# Redis (optional in dev; BullModule handles undefined)
REDIS_HOST=localhost
REDIS_PORT=6379
# WhatsApp config (non-critical in dev)
WHATSAPP_API_URL=http://localhost:4000/mock
WHATSAPP_ACCESS_TOKEN=development
# JWT
JWT_SECRET=development-secret
# AI
DEEPSEEK_API_URL=http://localhost:5000/mock
DEEPSEEK_API_KEY=dev-key
# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
